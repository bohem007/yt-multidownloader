# Database connection settings for PostgreSQL
# WYMAGANE w produkcji (jedna z dwóch dróg: PG* poniżej albo DATABASE_URL wprost).
PGHOST='host'
PGDATABASE='mydatabase'
PGUSER='owner'
PGPASSWORD='mypassword'
PGSSLMODE='require'
PGCHANNELBINDING='require'

# Opcjonalny connection string dla src/config.py (host Neon z -pooler).
# Jeśli nieustawiony, config.py złoży go automatycznie z PG* powyżej.
# WYMAGANE w produkcji (albo to, albo komplet PG* powyżej) — SEKRET.
DATABASE_URL='postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require'

# Nazwa schematu tabeli jobs — separacja dev/produkcja (patrz schema.sql)
# Opcjonalna, domyślnie: dev
DB_SCHEMA=dev

# Sekret HMAC do hashowania adresów IP (rate limiting, client_ip_hash) — nigdy surowy IP
# WYMAGANE w produkcji — SEKRET. Puste w produkcji: aplikacja startuje, ale loguje
# ostrzeżenie (client_ip_hash byłby wtedy odwracalny przeszukaniem przestrzeni IPv4).
IP_HASH_SECRET=change-me-to-a-random-secret

# Application settings — wszystkie poniżej opcjonalne (limity darmowego tieru),
# przy braku brana jest wartość domyślna pokazana tutaj.
MAX_FILE_SIZE_MB=500
MAX_PLAYLIST_ITEMS=10
MAX_PLAYLIST_RD_ITEMS=20 # limit migawki listy dla Mix/Radio (list=RD…); zastępuje MAX_PLAYLIST_ITEMS dla tych URL-i
MAX_ZIP_SIZE_MB=500 # limit rozmiaru ZIP-a przy pobieraniu całej playlisty
MAX_CONCURRENT_JOBS=2
ITEM_DOWNLOAD_TIMEOUT_SECONDS=180 # twardy limit czasu na pobranie JEDNEJ pozycji (defense-in-depth, niezależny od retries yt-dlp)
DOWNLOAD_LINK_TTL_MINUTES=30 # ile minut ZIP playlisty czeka na dysku pod linkiem do pobrania
RATE_LIMIT_PER_IP=10 # (żądań/godzinę)
RATE_LIMITING_ENABLED=true # domyślnie włączone w production, opcjonalne lokalnie
HISTORY_RETENTION_DAYS=5 # (dni; widok historii + kasowanie starszych wierszy z bazy, >= 1)

# Opcjonalna, domyślnie: local. Dozwolone wartości: local|production.
# WYMAGANE jawne ustawienie na "production" w HF Spaces (Variable) — steruje
# widocznością historii dla nieznanego IP i ostrzeżeniem o pustym IP_HASH_SECRET.
ENVIRONMENT=local|production

# Opcjonalny bazowy katalog tymczasowy dla plików pobierania (storage.py).
# Jeśli nieustawiony: tempfile.gettempdir() lokalnie, /tmp w produkcji.
STORAGE_BASE_DIR=/tmp
