# Database connection settings for PostgreSQL
PGHOST='host'
PGDATABASE='mydatabase'
PGUSER='owner'
PGPASSWORD='mypassword'
PGSSLMODE='require'
PGCHANNELBINDING='require'

# Opcjonalny connection string dla src/config.py (host Neon z -pooler).
# Jeśli nieustawiony, config.py złoży go automatycznie z PG* powyżej.
DATABASE_URL='postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require'

# Nazwa schematu tabeli jobs — separacja dev/produkcja (patrz schema.sql)
DB_SCHEMA=dev

# Sekret HMAC do hashowania adresów IP (rate limiting, client_ip_hash) — nigdy surowy IP
IP_HASH_SECRET=change-me-to-a-random-secret

# Application settings
MAX_FILE_SIZE_MB=500
MAX_PLAYLIST_ITEMS=10
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_IP=10 # (żądań/godzinę)
RATE_LIMITING_ENABLED=true # domyślnie włączone w production, opcjonalne lokalnie
ENVIRONMENT=local|production

# Opcjonalny bazowy katalog tymczasowy dla plików pobierania (storage.py).
# Jeśli nieustawiony: tempfile.gettempdir() lokalnie, /tmp w produkcji.
STORAGE_BASE_DIR=/tmp
